@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET Eigen3::Eigen)
  find_dependency(Eigen3)
endif()
# Same VTK/MPI workaround as the build: find_dependency(PCL) runs in the
# consumer's scope, where nothing has satisfied MPI::MPI_C either.
find_package(MPI QUIET)
if(NOT TARGET MPI::MPI_C)
  add_library(MPI::MPI_C INTERFACE IMPORTED)
endif()
find_dependency(PCL COMPONENTS common io filters)
find_dependency(yaml-cpp)
find_dependency(bievr_lio)
find_dependency(bievr_scancontext)

include("${CMAKE_CURRENT_LIST_DIR}/bievr_map_ioTargets.cmake")

check_required_components(bievr_map_io)
